<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+. Asked for once signed in: see EnsureNotificationPermission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cooknco.Splash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cooknco.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for Google OAuth callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cooknco" android:host="login" />
            </intent-filter>
        </activity>

        <!-- Hands a camera app a writable URI for the one file a capture is staged in.
             A file:// URI has thrown FileUriExposedException since Android 7, which is this
             app's floor, so there is no version of this that works without a provider.
             Note what is *not* declared alongside it: android.permission.CAMERA. The
             capture intent does not need it — the camera app has its own — and declaring it
             would make the intent require a grant from us as well. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Receives pushes. Also started with the app not running, which is why it sets
             up the object graph itself. -->
        <service
            android:name=".CookncoMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Used by the system for a notification it draws itself, i.e. every one that
             arrives while the app is backgrounded or stopped. Without these, that case
             falls back to the launcher icon, which is not a silhouette and renders as a
             grey square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <!-- Must match FcmPushSender.DEFAULT_CHANNEL_ID and the channel MainActivity
             creates: a message naming an absent channel is dropped on Android 8+. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="cooknco_default" />
    </application>

</manifest>

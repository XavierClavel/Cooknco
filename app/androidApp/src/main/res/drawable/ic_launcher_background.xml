<?xml version="1.0" encoding="utf-8"?>
<!--
  The background layer of the adaptive launcher icon.

  Flat CookncoBackground, which is the cream the logo's own badge is filled with
  (`.cls-2` in frontend/src/assets/logo.svg) and the colour the splash window and the app
  behind it are painted. Nothing is drawn on it: a launcher is free to parallax the two
  layers against each other, and a pattern that slides under the mark reads as a glitch.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#F0F4EF"
        android:pathData="M0,0h108v108h-108z" />
</vector>

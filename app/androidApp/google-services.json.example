{
  "_comment": [
    "Template for androidApp/google-services.json, which is NOT in the repository.",
    "Download the real one from the Firebase console: Project settings -> Your apps ->",
    "the Android app whose package name is com.xavierclavel.cooknco -> google-services.json,",
    "and save it next to this file. The Gradle build fails with a clear message until you do.",
    "It pairs with the backend's service account key: both have to name the same project.",
    "See docs/notifications.md."
  ],
  "project_info": {
    "project_number": "000000000000",
    "project_id": "your-firebase-project-id",
    "storage_bucket": "your-firebase-project-id.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "1:000000000000:android:0000000000000000000000",
        "android_client_info": {
          "package_name": "com.xavierclavel.cooknco"
        }
      },
      "oauth_client": [],
      "api_key": [
        {
          "current_key": "REPLACE_WITH_THE_ANDROID_API_KEY"
        }
      ],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": []
        }
      }
    }
  ],
  "configuration_version": "1"
}
